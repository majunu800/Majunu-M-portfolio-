# ==============================================
# Backend Environment Variables
# ==============================================
# Copy this file to .env and fill in your values

# MongoDB Connection URI
# Format: mongodb://username:password@host:port/database
# Example: mongodb+srv://user:password@cluster.mongodb.net/portfolio-db
MONGO_URI=mongodb://127.0.0.1:27017/personal-portfolio

# JWT Secret Key
# Use a strong, random string for production
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_change_me_in_production

# Server Port
# Default: 5000
PORT=5000

# Email notification settings (optional; messages are still saved to MongoDB without these)
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password
EMAIL_TO=your_email@example.com
# Optional: set to "gmail" when using a Gmail account
# EMAIL_SERVICE=gmail
